# Kopiere diese Datei nach .env und passe sie an:  cp .env.example .env
# Alle Werte haben sinnvolle Vorgaben -- ohne Aenderung laeuft die Plattform
# mit dem Offline-Spielleiter, also ganz ohne externe Dienste.

# --- Netzwerk ----------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443
# Adresse, unter der die Anwendung erreichbar ist. Fuer den Zugriff vom
# Smartphone die LAN-IP eintragen, z. B. http://192.168.1.50:8080
PUBLIC_BASE_URL=http://localhost:8080
# Fuer eine echte Domain mit automatischem HTTPS: SITE_ADDRESS=pnp.example.org
SITE_ADDRESS=:80

# --- Datenbank ---------------------------------------------------------
POSTGRES_USER=kipnp
POSTGRES_PASSWORD=kipnp
POSTGRES_DB=kipnp

# --- Sicherheit --------------------------------------------------------
# Unbedingt aendern (z. B. `openssl rand -hex 32`).
JWT_SECRET=bitte-in-produktion-aendern

# --- KI ----------------------------------------------------------------
# mock      = Offline-Spielleiter, kein Schluessel noetig (Voreinstellung)
# anthropic = Claude API
# openai    = OpenAI-kompatible API (auch vLLM, LM Studio, LiteLLM)
# ollama    = lokales Modell im Profil "local-ai"
AI_PROVIDER=mock
AI_MODEL=claude-opus-5
# Denktiefe: low | medium | high | xhigh | max
AI_EFFORT=high
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Sprachausgabe -----------------------------------------------------
# browser = Ausgabe im Browser (kein Dienst noetig)
# none    = keine Sprachausgabe
# openai  = serverseitige Synthese ueber den Medien-Worker
TTS_PROVIDER=browser

# --- Betrieb -----------------------------------------------------------
ENVIRONMENT=prod
