# Kopiere diese Datei nach .env und passe sie an:  cp .env.example .env
# Alle Werte haben sinnvolle Vorgaben -- ohne Aenderung laeuft die Plattform
# mit dem Offline-Spielleiter, also ganz ohne externe Dienste.

# --- Netzwerk ----------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443
# Adresse, unter der die Anwendung erreichbar ist. Fuer den Zugriff vom
# Smartphone die LAN-IP eintragen, z. B. http://192.168.1.50:8080
PUBLIC_BASE_URL=http://localhost:8080
# Fuer eine echte Domain mit automatischem HTTPS: SITE_ADDRESS=pnp.example.org
SITE_ADDRESS=:80

# --- Datenbank ---------------------------------------------------------
POSTGRES_USER=kipnp
POSTGRES_PASSWORD=kipnp
POSTGRES_DB=kipnp

# --- Sicherheit --------------------------------------------------------
# Unbedingt aendern (z. B. `openssl rand -hex 32`).
JWT_SECRET=bitte-in-produktion-aendern
# Sichert das installationsweite Einstellungen-Menue (/settings), unabhaengig
# von Spieler-/Spielleiter-Token. Leer gelassen ist der Bereich deaktiviert.
# Zum Erzeugen z. B. `openssl rand -hex 24`.
SETTINGS_PASSWORD=

# --- KI ----------------------------------------------------------------
# mock      = Offline-Spielleiter, kein Schluessel noetig (Voreinstellung)
# openai    = OpenAI oder eine kompatible API (vLLM, LM Studio, LiteLLM)
# anthropic = Claude API
# ollama    = lokales Modell im Profil "local-ai"
AI_PROVIDER=mock
# Muss zum Anbieter passen! openai: gpt-4o oder gpt-4o-mini
#                           anthropic: claude-opus-5
AI_MODEL=claude-opus-5
# Denktiefe, nur fuer Claude: low | medium | high | xhigh | max
AI_EFFORT=high
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Sprachausgabe -----------------------------------------------------
# browser = das Endgeraet spricht selbst, kein Dienst noetig (Voreinstellung)
# openai  = der Server erzeugt eine Aufnahme; braucht den Medien-Worker
# none    = keine Sprachausgabe
TTS_PROVIDER=browser
TTS_MODEL=gpt-4o-mini-tts
# OpenAI-Stimmen: alloy echo fable onyx nova shimmer
TTS_VOICE=onyx
TTS_FORMAT=mp3
# Fuer ein lokales, OpenAI-kompatibles Modell hierhin zeigen, z. B.
#   http://kokoro:8880/v1   oder   http://openedai-speech:8000/v1
# Ein Schluessel ist dann entbehrlich.
TTS_BASE_URL=https://api.openai.com/v1
# Leer lassen, um OPENAI_API_KEY zu verwenden.
TTS_API_KEY=
# So viele Aufnahmen bleiben je Runde gespeichert.
AUDIO_KEEP_LAST=200

# --- Betrieb -----------------------------------------------------------
ENVIRONMENT=prod
